{$CHATWOOT_DOMAIN} {
	encode zstd gzip

	# Recusa sondagens automatizadas por arquivos de configuracao e repositorios.
	@sensitive path *.env* */.git/* */.svn/* */.hg/* */.DS_Store
	respond @sensitive 404

	handle_path /orby-bridge/* {
		reverse_proxy {
			# Containers podem trocar de IP após uma atualização. Resolve o nome
			# pelo DNS interno do Docker continuamente para evitar 502 até o
			# próximo restart do Caddy.
			dynamic a bridge 8081 {
				refresh 5s
				resolvers 127.0.0.11
				versions ipv4
			}
		}
	}

	handle {
		reverse_proxy {
			dynamic a rails 3000 {
				refresh 5s
				resolvers 127.0.0.11
				versions ipv4
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

