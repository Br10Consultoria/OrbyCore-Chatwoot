{$CHATWOOT_DOMAIN} {
	encode zstd gzip

	# Recusa sondagens automatizadas por arquivos de configuracao e repositorios.
	@sensitive path *.env* */.git/* */.svn/* */.hg/* */.DS_Store
	respond @sensitive 404

	handle_path /orby-bridge/* {
		reverse_proxy bridge:8081
	}

	handle {
		reverse_proxy rails:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

