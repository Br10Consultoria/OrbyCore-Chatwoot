# Domínios
CHATWOOT_DOMAIN=chat.exemplo.com.br
FRONTEND_URL=https://chat.exemplo.com.br

# Chatwoot Community Edition. Fixe uma versão vX.Y.Z-ce antes de produção.
CHATWOOT_IMAGE=chatwoot/chatwoot:latest-ce
SECRET_KEY_BASE=gere_com_openssl_rand_hex_64
POSTGRES_PASSWORD=troque_esta_senha
REDIS_PASSWORD=troque_esta_senha
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=pt_BR

# SMTP (necessário para convites e notificações)
MAILER_SENDER_EMAIL=OrbyCore Atendimento <atendimento@exemplo.com.br>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Bridge OrbyCore
BRIDGE_SERVICE_TOKEN=gere_um_token_longo
CHATWOOT_WEBHOOK_TOKEN=gere_outro_token_longo
CHATWOOT_API_URL=http://rails:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=preencher_apos_criar_usuario_de_integracao
CHATWOOT_INBOX_ID=1
CHATWOOT_INBOX_IDENTIFIER=preencher_apos_criar_inbox_website
CHATWOOT_INBOX_HMAC_TOKEN=preencher_no_chatwoot
ORBYCORE_API_URL=http://host.docker.internal:8000
ORBYCORE_PORTAL_URL=https://portal.exemplo.com.br/portal
ORBYCORE_SERVICE_TOKEN=preencher_token_de_servico_orbycore
AUTOMATION_ENABLED=true
AUTOMATION_TRIGGER_PREFIX=/
LOG_LEVEL=INFO

