# Domínios
CHATWOOT_DOMAIN=chat.exemplo.com.br
FRONTEND_URL=https://chat.exemplo.com.br

# Chatwoot Community Edition homologado. Atualize somente após validar as notas da versão.
CHATWOOT_IMAGE=chatwoot/chatwoot:v4.16.2-ce
ACTIVE_STORAGE_SERVICE=local
SECRET_KEY_BASE=gere_com_openssl_rand_hex_64
POSTGRES_PASSWORD=troque_esta_senha
REDIS_PASSWORD=troque_esta_senha
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=pt_BR
CHATWOOT_WIDGET_COLOR=#087FAE
CHATWOOT_WIDGET_WELCOME_TITLE=Olá! Como podemos ajudar?
CHATWOOT_WIDGET_WELCOME_TAGLINE=Suporte técnico, financeiro e contratação em um só lugar.

# SMTP (necessário para convites e notificações)
MAILER_SENDER_EMAIL=OrbyCore Atendimento <atendimento@exemplo.com.br>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Bridge OrbyCore
BRIDGE_SERVICE_TOKEN=gere_um_token_longo
CHATWOOT_WEBHOOK_TOKEN=gere_outro_token_longo
CHATWOOT_API_URL=http://rails:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=preencher_apos_criar_usuario_de_integracao
CHATWOOT_INBOX_ID=1
CHATWOOT_AGENT_BOT_ID=0
CHATWOOT_INBOX_IDENTIFIER=preencher_apos_criar_inbox_website
CHATWOOT_INBOX_HMAC_TOKEN=preencher_no_chatwoot
CHATWOOT_TEAM_SUPPORT_ID=0
CHATWOOT_TEAM_FINANCIAL_ID=0
CHATWOOT_TEAM_COMMERCIAL_ID=0
ORBYCORE_API_URL=http://host.docker.internal:8000
ORBYCORE_PORTAL_URL=https://portal.exemplo.com.br/portal
ORBYCORE_SERVICE_TOKEN=preencher_token_de_servico_orbycore
AUTOMATION_ENABLED=true
AUTOMATION_TRIGGER_PREFIX=/
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_MAX_BACKOFF_SECONDS=30
BACKUP_RETENTION_DAYS=30
LOG_LEVEL=INFO

